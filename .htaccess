AddType application/manifest+json .webmanifest
AddType application/x-x509-ca-cert .crt

# Compresión gzip para respuestas de texto
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
    Header append Vary Accept-Encoding
</IfModule>

# Caché de imágenes y videos en el navegador
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/gif               "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 7 days"
    ExpiresByType video/mp4               "access plus 7 days"
    ExpiresByType video/webm              "access plus 7 days"
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
    # immutable: el navegador no revalida durante el max-age (elimina requests condicionales)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(mp4|webm|ogg)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Soporte Range requests para videos (streaming / seek)
<IfModule mod_headers.c>
    <FilesMatch "\.(mp4|webm|ogg)$">
        Header set Accept-Ranges bytes
    </FilesMatch>
</IfModule>

# Nunca ejecutar PHP desde uploads/ y no exponer datos internos
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/.*\.(php|phtml|phar)$ - [F,L]
    RewriteRule ^(agente|sync|sync-papelera|instalacion-portarretrato)/ - [F,L]
    RewriteRule ^backend/(config|config\.local|bootstrap|sync_lib|config\.local\.sample)\.php$ - [F,L]
    RewriteRule ^schema\.sql$ - [F,L]
</IfModule>
