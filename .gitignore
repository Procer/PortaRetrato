# ------- .gitignore -------
# Ignorar carpetas de recursos multimedia
imagenes/
videos/
uploads/
# Archivos y carpetas habituales que no deben versionarse
/vendor/
node_modules/
.env
*.log
*.tmp
.DS_Store
Thumbs.db
.gstack/
# Claude Code y temporales locales
.claude/
clean_temp/
# Config con credenciales — cada instalación tiene la suya
backend/config.local.php
PortaRetrato.zip
php/

# Carpeta sincronizada (Syncthing) y su papelera: son las fotos del usuario
sync/
sync-papelera/
agente/importar.log*

# Temporales de pruebas locales
cj
foto*.jpeg
